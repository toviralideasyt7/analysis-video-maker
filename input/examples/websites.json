 "facts": [
  {
   "atDate": "1996",
   "heading": "The wild west",
   "body": "Web directories and classified boards rule. Yahoo! hand-lists the internet; Amazon sells its first book.",
   "tiles": [
    "yahoo",
    "amazon"
   ]
  },
  {
   "atDate": "2000",
   "heading": "The portal era",
   "body": "Yahoo! and MSN fight to be your homepage. Search is a feature, not yet a kingdom.",
   "tiles": [
    "yahoo",
    "msn"
   ]
  },
  {
   "atDate": "2004",
   "heading": "A book of faces",
   "body": "Facebook opens to universities. Wikipedia quietly becomes the reference shelf of the web.",
   "tiles": [
    "facebook",
    "wikipedia"
   ]
  },
  {
   "atDate": "2007",
   "heading": "The iPhone year",
   "body": "Mobile traffic begins its climb. Google passes every portal and never looks back.",
   "tiles": [
    "google",
    "youtube"
   ]
  },
  {
   "atDate": "2012",
   "heading": "Social takes over",
   "body": "Facebook and YouTube trade the lead. Time spent starts to matter more than page views.",
   "tiles": [
    "facebook",
    "youtube"
   ]
  },
  {
   "atDate": "2018",
   "heading": "Video wins attention",
   "body": "YouTube approaches thirty billion monthly visits; Instagram closes in fast.",
   "tiles": [
    "youtube",
    "instagram"
   ]
  },
  {
   "atDate": "2023",
   "heading": "AI arrives",
   "body": "ChatGPT becomes the fastest-growing site in history within months of launch.",
   "tiles": [
    "chatgpt",
    "google"
   ]
  },
  {
   "atDate": "2026",
   "heading": "One giant, many rooms",
   "body": "Google dwarfs everything, but social and AI keep pulling hours away from the open web.",
   "tiles": [
    "google",
    "youtube"
   ]
  }
