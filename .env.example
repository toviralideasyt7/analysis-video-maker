# ---------------------------------------------------------------------------
# analysis-video-maker - environment template
# Copy to `.env` and fill in real values. NEVER commit `.env` or any key.
# ---------------------------------------------------------------------------

# --- AI providers ---------------------------------------------------------
# Gemini web-proxy workers (OpenAI-compatible, no API key required).
GEMINI_WORKER_1=https://gemini-web-proxy.shonratt.workers.dev
GEMINI_WORKER_2=https://gemini-web-proxy.dipteshray7.workers.dev
# Names of the models exposed by those workers (comma separated).
GEMINI_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-thinking,gemini-flash-lite,gemini-auto

# Nara router (optional secondary provider, OpenAI-compatible).
NARA_BASE_URL=https://router.bynara.id/v1
NARA_API_KEY=
NARA_MODELS=nex-n2.5-pro,agnes-2.5-flash

# Optional OpenAI-compatible backup
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Search / fetch -------------------------------------------------------
# Monid proxy API (TinyFish search + fetch).
MONID_BASE_URL=https://api.monid.ai/v1
MONID_API_KEY=
MONID_SEARCH_PROVIDER=tinyfish
MONID_SEARCH_ENDPOINT=/search
MONID_FETCH_ENDPOINT=/fetch

# --- Dataset sources ------------------------------------------------------
KAGGLE_USERNAME=
KAGGLE_KEY=
HUGGINGFACE_TOKEN=

# --- Storage / orchestration ---------------------------------------------
# Local filesystem root for project state (Render free tier has no durable disk).
PROJECTS_DIR=./projects
RENDER_CACHE_DIR=./.cache
# Cloudflare R2 (S3-compatible) for rendered artifacts.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Rendering dispatch ---------------------------------------------------
# GitHub Actions dispatch (render layer). Token needs `repo` + `workflow` scope.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_WORKFLOW_FILE=render-video.yml

# --- Rust core ------------------------------------------------------------
# Path to the compiled `datarace` binary. Empty => auto-discover.
DATARACE_BIN=

# --- Limits (cost control per project) -----------------------------------
MAX_SEARCHES=60
MAX_SOURCES=40
MAX_AGENT_ROUNDS=12
MAX_TOKENS=400000
MAX_RENDER_ATTEMPTS=2

# --- Backend --------------------------------------------------------------
PORT=8787
ALLOWED_ORIGINS=http://localhost:5173