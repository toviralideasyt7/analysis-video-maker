{
  "name": "analysis-video-maker",
  "private": true,
  "version": "0.2.0",
  "description": "Data-race videos from a user-supplied data file: upload -> GitHub Actions -> MP4.",
  "type": "module",
  "engines": { "node": ">=20" },
  "workspaces": [
    "packages/shared",
    "services/uploader",
    "renderer",
    "apps/web"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "rust:test": "cargo test --workspace",
    "rust:build": "cargo build --release --workspace",
    "render": "npm run render -w @avm/renderer",
    "make:video": "npm run make -w @avm/uploader",
    "dev:web": "npm run dev -w @avm/web",
    "dev:api": "npm run serve -w @avm/uploader"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  }
}