{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://analysis-video-maker/schemas/video-input.schema.json",
  "title": "VideoInput",
  "description": "Everything the renderer needs, supplied by the user in one file: data, colors, facts, groups. No research step, no AI in the loop.",
  "type": "object",
  "required": ["version", "title", "metric", "unit", "observations"],
  "additionalProperties": true,
  "properties": {
    "version": { "const": "1.0" },
    "title": { "type": "string", "minLength": 1 },
    "metric": { "type": "string", "minLength": 1 },
    "unit": { "type": "string", "minLength": 1 },
    "valueFormat": { "enum": ["comma", "compact"] },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 320 },
        "height": { "type": "integer", "minimum": 240 },
        "fps": { "type": "integer", "enum": [30, 60] }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "topN": { "type": "integer", "minimum": 3, "maximum": 20 },
        "secondsPerYear": { "type": "number", "exclusiveMinimum": 0 },
        "scalePower": { "type": "number", "exclusiveMinimum": 0 },
        "minIntervalSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "introSeconds": { "type": "number", "minimum": 0 },
        "outroSeconds": { "type": "number", "minimum": 0 },
        "backgroundColor": { "type": "string" },
        "dateDisplay": { "enum": ["auto", "year", "bC"] }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "color": { "type": "string" },
          "flagCode": { "type": ["string", "null"] },
          "logoUrl": { "type": ["string", "null"] },
          "group": { "type": ["string", "null"] }
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["entity", "date", "value"],
        "additionalProperties": true,
        "properties": {
          "entity": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "minLength": 1 },
          "value": { "type": "number" }
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["atDate", "heading"],
        "additionalProperties": true,
        "properties": {
          "atDate": { "type": "string", "minLength": 1 },
          "heading": { "type": "string", "minLength": 1 },
          "body": { "type": "string" },
          "tiles": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "color": { "type": "string" }
        }
      }
    },
    "worldTotal": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "value"],
        "additionalProperties": true,
        "properties": {
          "date": { "type": "string", "minLength": 1 },
          "value": { "type": "number" }
        }
      }
    },
    "sources": { "type": "string" },
    "endingTitle": { "type": "string" }
  }
}