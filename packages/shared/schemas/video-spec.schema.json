{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://analysis-video-maker/schemas/video-spec.schema.json",
  "title": "VideoSpec",
  "type": "object",
  "required": ["version", "metadata", "canvas", "theme", "datasetRef", "scenes", "assets", "sources"],
  "additionalProperties": true,
  "properties": {
    "version": { "const": "1.0" },
    "metadata": {
      "type": "object",
      "required": ["title", "language", "durationSeconds"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "language": { "type": "string", "minLength": 2 },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "canvas": {
      "type": "object",
      "required": ["width", "height", "fps"],
      "properties": {
        "width": { "type": "integer", "minimum": 320 },
        "height": { "type": "integer", "minimum": 240 },
        "fps": { "type": "integer", "minimum": 1, "maximum": 120 }
      }
    },
    "theme": {
      "type": "object",
      "required": ["background", "primaryText", "fontFamily"],
      "additionalProperties": { "type": ["string", "number"] },
      "properties": {
        "background": { "type": "string" },
        "primaryText": { "type": "string" },
        "fontFamily": { "type": "string" }
      }
    },
    "datasetRef": { "type": "string", "minLength": 1 },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "duration"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "enum": [
              "title", "subtitle", "intro", "bar_race", "horizontal_rank_bars",
              "number_counter", "rank_change", "highlight", "comparison",
              "timeline", "map", "ending", "source_card", "fact_box",
              "continent_chart", "pie_summary"
            ]
          },
          "duration": { "type": "number", "exclusiveMinimum": 0 },
          "title": { "type": "string" },
          "subtitle": { "type": "string" },
          "datasetRef": { "type": "string" },
          "entities": { "type": "array", "items": { "type": "string" } },
          "props": { "type": "object" }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assetId", "type", "url", "source", "license", "retrievedAt"],
        "properties": {
          "assetId": { "type": "string" },
          "entityId": { "type": "string" },
          "type": { "enum": ["logo", "photo", "icon", "flag", "map", "background", "font", "audio"] },
          "url": { "type": "string" },
          "source": { "type": "string" },
          "license": { "type": "string" },
          "retrievedAt": { "type": "string" },
          "localPath": { "type": "string" },
          "hash": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "publisher", "retrievedAt"],
        "properties": {
          "url": { "type": "string" },
          "publisher": { "type": "string" },
          "title": { "type": "string" },
          "publishedAt": { "type": ["string", "null"] },
          "retrievedAt": { "type": "string" }
        }
      }
    }
  }
}