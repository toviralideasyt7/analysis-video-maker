{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://analysis-video-maker/schemas/agent-outputs.schema.json",
  "title": "AgentOutputs",
  "description": "Structured contracts for internal agent results. Each definition is compiled separately by the shared validator.",
  "definitions": {
    "scouting": {
      "type": "object",
      "required": ["queries"],
      "additionalProperties": true,
      "properties": {
        "queries": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 4 } },
        "knownSources": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["url", "why"],
            "properties": {
              "name": { "type": "string" },
              "url": { "type": "string", "minLength": 3 },
              "why": { "type": "string", "minLength": 3 }
            }
          }
        }
      }
    },
    "sourceSelection": {
      "type": "object",
      "required": ["picks"],
      "additionalProperties": true,
      "properties": {
        "picks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["candidateId", "why"],
            "properties": {
              "candidateId": { "type": "string", "minLength": 1 },
              "rank": { "type": "integer", "minimum": 1 },
              "why": { "type": "string", "minLength": 3 },
              "directDataUrl": { "type": "string" }
            }
          }
        },
        "rejected": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["candidateId", "why"],
            "properties": {
              "candidateId": { "type": "string", "minLength": 1 },
              "why": { "type": "string", "minLength": 3 }
            }
          }
        },
        "dataUrls": { "type": "array", "items": { "type": "string" } }
      }
    },
    "extractedRows": {
      "type": "object",
      "required": ["rows"],
      "additionalProperties": true,
      "properties": {
        "rows": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object",
            "required": ["entity", "date", "quote"],
            "properties": {
              "entity": { "type": "string", "minLength": 1 },
              "date": { "type": "string", "minLength": 2 },
              "value": { "type": ["number", "null"] },
              "unit": { "type": "string" },
              "quote": { "type": "string", "minLength": 8 }
            }
          }
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "aiQaVerdict": {
      "type": "object",
      "required": ["passed", "problems"],
      "additionalProperties": true,
      "properties": {
        "passed": { "type": "boolean" },
        "problems": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "revisionPlan": {
      "type": "object",
      "required": ["instruction", "datasetFilters", "storyOverrides", "videoOverrides", "notes"],
      "additionalProperties": true,
      "properties": {
        "instruction": { "type": "string" },
        "datasetFilters": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "allowStatuses": { "type": "array", "items": { "type": "string" } },
            "topN": { "type": "integer", "minimum": 1 },
            "removeEntityIds": { "type": "array", "items": { "type": "string" } },
            "annualOnly": { "type": "boolean" }
          }
        },
        "storyOverrides": { "type": "object", "additionalProperties": true },
        "videoOverrides": { "type": "object", "additionalProperties": true },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}